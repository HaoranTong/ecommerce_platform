    def _generate_e2e_tests(
        self, module_name: str, models: Dict[str, ModelInfo]
    ) -> Dict[str, str]:
        """生成E2E测试 (6%) - API测试和业务流程测试
        
        基于router.py分析生成：
        1. API端点测试 - 测试所有REST API端点
        2. 业务流程测试 - 测试完整的用户场景
        3. 跨模块集成测试 - 测试模块间依赖
        """
