        files.update(e2e_tests)
        
        print(f"✅ 生成E2E测试: 业务流程测试")
        return files

    def _generate_smoke_tests(
        self, module_name: str, models: Dict[str, ModelInfo]
    ) -> Dict[str, str]:
        """烟雾测试使用通用脚本，不需要为每个模块单独生成

        现有的 tools/smoke_test.ps1 和 tests/smoke/ 目录已经提供了：
        - 通用API连通性测试
        - 系统健康检查
        - 基础功能验证
