{
  "_description": "测试生成器配置文件 - 智能五层架构测试生成器核心配置",
  "_usage": {
    "primary_tool": "tools/generate_test_template.py",
    "description": "为电商平台模块化架构提供智能测试代码生成配置",
    "backup_strategy": "如果此文件不存在，生成器将使用内置默认配置",
    "modification_guide": "修改此文件可以自定义测试生成行为、路径分布、数据库配置等"
  },
  "_referenced_by": [
    "tools/generate_test_template.py (主要引用者)",
    "docs/status/work-history-archive.md (文档记录)",
    "docs/development/test_generator_optimization_report.md (优化报告)"
  ],
  "_version": "2.0",
  "_last_updated": "2025-10-02",
  "project_structure": {
    "project_root": ".",
    "modules_path": "app/modules",
    "models_file": "models.py",
    "service_file": "service.py",
    "router_file": "router.py",
    "tests_path": "tests",
    "factories_path": "tests/factories"
  },
  "test_distributions": {
    "unit": 0.70,
    "integration": 0.20,
    "e2e": 0.06,
    "smoke": 0.02,
    "specialized": 0.02
  },
  "test_paths": {
    "unit_models": "tests/unit/test_models",
    "unit_services": "tests/unit/test_services",
    "unit_standalone": "tests/unit",
    "integration": "tests/integration",
    "e2e": "tests/e2e",
    "smoke": "tests/smoke",
    "performance": "tests/performance",
    "factories": "tests/factories"
  },
  "database_config": {
    "unit_test_fixture": "unit_test_db",
    "integration_test_fixture": "mysql_integration_db",
    "e2e_test_fixture": "api_client",
    "test_database_url": "mysql+pymysql://root:test_password@localhost:3308/ecommerce_platform_test",
    "unit_database_url": "sqlite:///",
    "database_cleanup_order": [
      "OrderItem", "OrderStatusHistory", "Refund", "Payment", "Order",
      "RolePermission", "UserRole", "Session", "User", "Permission", "Role",
      "InventoryTransaction", "InventoryReservation", "InventoryStock",
      "SKUAttribute", "ProductAttribute", "ProductImage", "ProductTag",
      "SKU", "Product", "Brand", "Category"
    ]
  },
  "code_generation": {
    "add_generation_headers": true,
    "validate_test_code": true,
    "direct_to_formal_dirs": true,
    "timeout_seconds": 300
  },
  "business_logic_patterns": {
    "user_fields": ["username", "email", "password", "phone", "real_name"],
    "audit_fields": ["created_at", "updated_at", "created_by", "updated_by"],
    "status_fields": ["status", "state", "is_active", "enabled", "deleted"],
    "financial_fields": ["price", "cost", "amount", "balance", "total", "fee"],
    "inventory_fields": ["stock", "quantity", "available", "reserved", "current_stock"],
    "relationship_patterns": {
      "one_to_many": ["items", "orders", "products", "children", "permissions"],
      "many_to_one": ["user", "category", "parent", "owner", "brand"],
      "many_to_many": ["tags", "permissions", "roles", "attributes"]
    },
    "common_models": {
      "User": ["user_auth", "member_system"],
      "Role": ["user_auth"],
      "Permission": ["user_auth"],
      "Product": ["product_catalog"],
      "SKU": ["product_catalog"],
      "Order": ["order_management"],
      "Category": ["product_catalog"],
      "Brand": ["product_catalog"]
    },
    "route_parameter_to_model_mapping": {
      "_description": "路由路径参数到模型名的映射表 - API测试代码生成的唯一数据源",
      "_usage": "用于解析 {entity_type}_id 路径参数对应的模型名，如 /items/{item_id} 在不同模块对应不同模型",
      "shopping_cart": {
        "item": "CartItem",
        "cart": "Cart"
      },
      "order_management": {
        "item": "OrderItem",
        "order": "Order",
        "history": "OrderStatusHistory"
      },
      "inventory_management": {
        "stock": "InventoryStock",
        "reservation": "InventoryReservation"
      },
      "product_catalog": {
        "category": "Category",
        "brand": "Brand",
        "product": "Product",
        "sku": "SKU"
      },
      "user_auth": {
        "user": "User",
        "role": "Role"
      },
      "payment_service": {
        "payment": "Payment"
      },
      "quality_control": {
        "cert": "QualityCertificate"
      },
      "member_system": {
        "activity": "MemberActivity"
      }
    },
    "table_to_module_mapping": {
      "_description": "表名到模块名的映射，用于跨模块依赖解析",
      "users": "user_auth",
      "roles": "user_auth",
      "permissions": "user_auth",
      "user_roles": "user_auth",
      "role_permissions": "user_auth",
      "sessions": "user_auth",
      "products": "product_catalog",
      "product_skus": "product_catalog",
      "categories": "product_catalog",
      "brands": "product_catalog",
      "product_attributes": "product_catalog",
      "sku_attributes": "product_catalog",
      "product_images": "product_catalog",
      "product_tags": "product_catalog",
      "carts": "shopping_cart",
      "cart_items": "shopping_cart",
      "orders": "order_management",
      "order_items": "order_management",
      "order_status_history": "order_management",
      "payments": "payment_service",
      "refunds": "payment_service",
      "inventory_stocks": "inventory_management",
      "inventory_reservations": "inventory_management",
      "inventory_transactions": "inventory_management",
      "member_levels": "member_system",
      "point_transactions": "member_system",
      "member_profiles": "member_system",
      "member_points": "member_system",
      "certificates": "quality_control"
    },
    "cross_module_dependency_chains": {
      "_description": "跨模块依赖链配置，定义创建实体时需要的完整依赖顺序",
      "shopping_cart": {
        "Cart": ["user_auth.User"],
        "CartItem": ["user_auth.User", "product_catalog.Category", "product_catalog.Brand", "product_catalog.Product", "product_catalog.SKU"]
      },
      "order_management": {
        "Order": ["user_auth.User"],
        "OrderItem": ["user_auth.User", "product_catalog.Category", "product_catalog.Brand", "product_catalog.Product", "product_catalog.SKU"]
      },
      "inventory_management": {
        "InventoryStock": ["product_catalog.Category", "product_catalog.Brand", "product_catalog.Product", "product_catalog.SKU"],
        "InventoryReservation": ["user_auth.User", "product_catalog.Category", "product_catalog.Brand", "product_catalog.Product", "product_catalog.SKU"],
        "InventoryTransaction": ["user_auth.User", "product_catalog.Category", "product_catalog.Brand", "product_catalog.Product", "product_catalog.SKU"]
      }
    },
    "api_test_business_rules": {
      "_description": "API测试的业务规则配置，定义跨模块业务依赖（不是外键依赖）",
      "sku_requires": ["inventory_management.InventoryStock"],
      "order_creation_requires": ["inventory_management.InventoryStock"],
      "cart_item_requires": []
    }
    ,
    "repository_priority_fields": [
      "real_name",
      "phone",
      "status",
      "role",
      "description",
      "remark",
      "note",
      "address"
    ]
  },
  "error_handling": {
    "max_retries": 3,
    "timeout_seconds": 30,
    "detailed_errors": true,
    "suggest_fixes": true,
    "fail_fast": false
  }
}