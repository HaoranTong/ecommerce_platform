{
  "method": "POST",
  "path": "/login",
  "auth_required": false,
  "admin_only": false,
  "request_schema": {
    "type": "object",
    "properties": {
      "username": {
        "type": "string",
        "description": "string (can be username or email)"
      },
      "password": {
        "type": "string",
        "description": "string"
      },
      "verification_code": {
        "type": "string",
        "description": "string? (required if failed >=3 times)"
      }
    },
    "required": [
      "username",
      "password"
    ]
  },
  "response_schema": {
    "type": "object",
    "properties": {
      "access_token": {
        "type": "string"
      },
      "refresh_token": {
        "type": "string"
      },
      "token_type": {
        "type": "string"
      },
      "expires_in": {
        "type": "integer"
      }
    },
    "required": [
      "access_token",
      "expires_in"
    ]
  },
  "errors": [
    {
      "code": "AUTH_ERROR_001",
      "http_status": 401,
      "message": "用户名或密码错误",
      "ui_hint": "请检查用户名和密码是否正确",
      "action": ""
    },
    {
      "code": "AUTH_ERROR_002",
      "http_status": 401,
      "message": "令牌无效或已过期",
      "ui_hint": "登录已过期，请重新登录",
      "action": "redirect_to_login"
    },
    {
      "code": "AUTH_ERROR_003",
      "http_status": 403,
      "message": "权限不足",
      "ui_hint": "您没有权限执行此操作",
      "action": ""
    },
    {
      "code": "AUTH_ERROR_004",
      "http_status": 403,
      "message": "账户已被锁定",
      "ui_hint": "账户因多次登录失败被锁定，请 30 分钟后重试",
      "action": ""
    },
    {
      "code": "AUTH_ERROR_005",
      "http_status": 400,
      "message": "用户名或邮箱已存在",
      "ui_hint": "该用户名或邮箱已被注册",
      "action": ""
    }
  ],
  "notes": "- 登录失败 3 次后，必须提供 verification_code\n- 登录失败 5 次，账户锁定 30 分钟\n- 成功登录后重置失败计数\n"
}