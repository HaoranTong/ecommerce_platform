{
  "method": "POST",
  "path": "/register",
  "auth_required": false,
  "admin_only": false,
  "request_schema": {
    "type": "object",
    "properties": {
      "username": {
        "type": "string",
        "description": "string (unique, 3-50 chars)"
      },
      "email": {
        "type": "string",
        "description": "string (valid format, unique)"
      },
      "password": {
        "type": "string",
        "description": "string (min 8 chars, letters + digits)"
      },
      "verification_code": {
        "type": "string",
        "description": "string (6-digit)"
      },
      "phone": {
        "type": "string",
        "description": "string? (optional, 11-digit CN mobile)"
      }
    },
    "required": [
      "username",
      "email",
      "password",
      "verification_code"
    ]
  },
  "response_schema": {
    "type": "object",
    "properties": {
      "user": {
        "type": "string"
      },
      "access_token": {
        "type": "string"
      },
      "refresh_token": {
        "type": "string"
      },
      "token_type": {
        "type": "string"
      }
    },
    "required": [
      "user",
      "access_token"
    ]
  },
  "errors": [
    {
      "code": "AUTH_ERROR_001",
      "http_status": 401,
      "message": "用户名或密码错误",
      "ui_hint": "请检查用户名和密码是否正确",
      "action": ""
    },
    {
      "code": "AUTH_ERROR_002",
      "http_status": 401,
      "message": "令牌无效或已过期",
      "ui_hint": "登录已过期，请重新登录",
      "action": "redirect_to_login"
    },
    {
      "code": "AUTH_ERROR_003",
      "http_status": 403,
      "message": "权限不足",
      "ui_hint": "您没有权限执行此操作",
      "action": ""
    },
    {
      "code": "AUTH_ERROR_004",
      "http_status": 403,
      "message": "账户已被锁定",
      "ui_hint": "账户因多次登录失败被锁定，请 30 分钟后重试",
      "action": ""
    },
    {
      "code": "AUTH_ERROR_005",
      "http_status": 400,
      "message": "用户名或邮箱已存在",
      "ui_hint": "该用户名或邮箱已被注册",
      "action": ""
    }
  ],
  "notes": "- 必须先调用 /verification-code?type=register\n- 密码必须包含字母和数字，至少 8 位\n- 成功后自动登录，返回 access_token + refresh_token\n"
}