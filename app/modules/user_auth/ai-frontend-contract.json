{
  "module": "user-auth",
  "base_url": "/api/v1/user-auth",
  "auth": {
    "type": "Bearer"
  },
  "token_schema": {
    "access_token": "string",
    "refresh_token": "string?",
    "token_type": "bearer",
    "expires_in": "integer"
  },
  "frontend_integration": {
    "auth_flow": [
      "登录成功后，将 access_token 存入内存（或安全存储）",
      "每次 API 请求在 Header 中添加: Authorization: Bearer <access_token>",
      "拦截 401 响应，尝试用 refresh_token 刷新",
      "refresh_token 也过期时，跳转到登录页"
    ],
    "password_rules": [
      "最少 8 位",
      "必须包含字母和数字",
      "不允许特殊字符（简化 UX）",
      "前端应实时校验并提示"
    ],
    "phone_format": [
      "仅支持中国大陆手机号：1[3-9]\\d{9}",
      "前端应自动格式化（如添加 +86 前缀，但提交时不带）"
    ],
    "real_name_handling": [
      "敏感字段，展示时建议脱敏（如 张*三）",
      "仅在必要场景（如实名认证、发票）要求填写"
    ]
  },
  "security_notes": [
    "禁止在 URL、LocalStorage（未加密）、Console 中打印 token",
    "所有认证接口必须使用 HTTPS（生产环境强制）",
    "验证码输入框应限制尝试次数（前端可做防爆破）",
    "登出后应清除所有本地认证状态"
  ],
  "endpoints": {
    "send_verification_code": {
      "method": "POST",
      "path": "/verification-code",
      "auth_required": false,
      "admin_only": false,
      "request_schema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "string"
          },
          "phone": {
            "type": "string",
            "description": "string?"
          },
          "code_type": {
            "type": "string",
            "description": "enum[register, login, reset_password, phone_login]"
          }
        },
        "required": [
          "email",
          "code_type"
        ]
      },
      "response_schema": {
        "type": "object"
      },
      "errors": [
        {
          "code": "AUTH_ERROR_001",
          "http_status": 401,
          "message": "用户名或密码错误",
          "ui_hint": "请检查用户名和密码是否正确",
          "action": ""
        },
        {
          "code": "AUTH_ERROR_002",
          "http_status": 401,
          "message": "令牌无效或已过期",
          "ui_hint": "登录已过期，请重新登录",
          "action": "redirect_to_login"
        },
        {
          "code": "AUTH_ERROR_003",
          "http_status": 403,
          "message": "权限不足",
          "ui_hint": "您没有权限执行此操作",
          "action": ""
        },
        {
          "code": "AUTH_ERROR_004",
          "http_status": 403,
          "message": "账户已被锁定",
          "ui_hint": "账户因多次登录失败被锁定，请 30 分钟后重试",
          "action": ""
        },
        {
          "code": "AUTH_ERROR_005",
          "http_status": 400,
          "message": "用户名或邮箱已存在",
          "ui_hint": "该用户名或邮箱已被注册",
          "action": ""
        }
      ],
      "notes": "- 开发环境会直接返回验证码（便于调试）\n- 生产环境仅返回成功消息，验证码通过邮件/短信发送\n- 同一邮箱/手机号 10 分钟内最多发送 3 次（后端限制）\n"
    },
    "register": {
      "method": "POST",
      "path": "/register",
      "auth_required": false,
      "admin_only": false,
      "request_schema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "string (unique, 3-50 chars)"
          },
          "email": {
            "type": "string",
            "description": "string (valid format, unique)"
          },
          "password": {
            "type": "string",
            "description": "string (min 8 chars, letters + digits)"
          },
          "verification_code": {
            "type": "string",
            "description": "string (6-digit)"
          },
          "phone": {
            "type": "string",
            "description": "string? (optional, 11-digit CN mobile)"
          }
        },
        "required": [
          "username",
          "email",
          "password",
          "verification_code"
        ]
      },
      "response_schema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string"
          },
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "access_token"
        ]
      },
      "errors": [
        {
          "code": "AUTH_ERROR_001",
          "http_status": 401,
          "message": "用户名或密码错误",
          "ui_hint": "请检查用户名和密码是否正确",
          "action": ""
        },
        {
          "code": "AUTH_ERROR_002",
          "http_status": 401,
          "message": "令牌无效或已过期",
          "ui_hint": "登录已过期，请重新登录",
          "action": "redirect_to_login"
        },
        {
          "code": "AUTH_ERROR_003",
          "http_status": 403,
          "message": "权限不足",
          "ui_hint": "您没有权限执行此操作",
          "action": ""
        },
        {
          "code": "AUTH_ERROR_004",
          "http_status": 403,
          "message": "账户已被锁定",
          "ui_hint": "账户因多次登录失败被锁定，请 30 分钟后重试",
          "action": ""
        },
        {
          "code": "AUTH_ERROR_005",
          "http_status": 400,
          "message": "用户名或邮箱已存在",
          "ui_hint": "该用户名或邮箱已被注册",
          "action": ""
        }
      ],
      "notes": "- 必须先调用 /verification-code?type=register\n- 密码必须包含字母和数字，至少 8 位\n- 成功后自动登录，返回 access_token + refresh_token\n"
    },
    "login": {
      "method": "POST",
